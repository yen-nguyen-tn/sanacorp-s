# Ignore everything by default — this repo only carries mock fixtures
# at the same paths used by the real Sanacorp-S Connect codebase.
/*

# Allow meta files
!/.gitignore
!/README.md

# Allow root package.json (semver lives here)
!/package.json

# Allow app/src/version.json only, ignore the rest of app/
!/app/
/app/*
!/app/src/
/app/src/*
!/app/src/version.json
